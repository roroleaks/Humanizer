# ────────────────────────────────────────────────────────────
# Scientific Humanizer — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ────────────────────────────────────────────────────────────

# Application
SH_APP_NAME="Scientific Humanizer"
SH_APP_ENV="development"            # development | staging | production
SH_APP_URL="http://localhost:3000"

# Page-count estimation
SH_PAGE_WORD_DENSITY="500"          # words per page, used for URL/text intake
SH_MAX_PAGES="15"

# Storage
SH_STORAGE_DRIVER="local"           # local | supabase | s3
SH_STORAGE_LOCAL_PATH="./.storage"
SH_STORAGE_RETENTION_DAYS="30"

# Database Configuration
SH_DATABASE_DRIVER="sqlite"         # sqlite (local dev) | postgres (staging/prod)
SH_DATABASE_SQLITE_PATH="./.storage/dev.db"
SH_DATABASE_URL=""
SH_SUPABASE_URL=""
SH_SUPABASE_ANON_KEY=""
SH_SUPABASE_SERVICE_ROLE_KEY=""

# AI Providers — leave blank in Phase 0/1; do not implement calls yet
SH_AI_OPENAI_API_KEY=""
SH_AI_OPENAI_DEFAULT_MODEL="gpt-4o"
SH_AI_GEMINI_API_KEY=""
SH_AI_GEMINI_DEFAULT_MODEL="gemini-1.5-pro"
SH_AI_ANTHROPIC_API_KEY=""
SH_AI_ANTHROPIC_DEFAULT_MODEL="claude-3-5-sonnet-latest"
SH_AI_OPENAI_COMPATIBLE_BASE_URL=""
SH_AI_OPENAI_COMPATIBLE_API_KEY=""
SH_AI_OPENAI_COMPATIBLE_DEFAULT_MODEL=""

# Orchestration
SH_AI_PRIMARY_PROVIDER="openai"
SH_AI_FALLBACK_PROVIDERS="gemini,anthropic"
SH_AI_MAX_RETRIES="3"
SH_AI_TIMEOUT_MS="60000"
SH_AI_TTFB_TIMEOUT_MS="15000"
SH_AI_INTERCHUNK_TIMEOUT_MS="10000"
SH_AI_CIRCUIT_FAILURE_THRESHOLD="5"
SH_AI_CIRCUIT_FAILURE_WINDOW_MS="60000"
SH_AI_CIRCUIT_OPEN_DURATION_MS="60000"
SH_AI_HEALTH_CHECK_INTERVAL_MS="60000"

# Security
SH_RATE_LIMIT_PER_MINUTE="20"
SH_URL_FETCH_ALLOW_PRIVATE_NETWORK="false"
SH_LOG_MANUSCRIPT_CONTENT="false"   # NEVER set to true in production

# Refinement Engine
SH_REFINE_TARGET_CHUNK_WORDS="500"
SH_REFINE_MAX_CHUNK_WORDS="800"
SH_REFINE_ADJACENT_SUMMARY_SENTENCES="2"

